# ===== AI Visual Assistant - konfigurasi backend =====
# Salin file ini menjadi ".env" (start.bat melakukannya otomatis).
# File .env TIDAK pernah dikirim ke browser.

# Port aplikasi web (hanya bisa dibuka dari komputer ini: http://127.0.0.1:3000)
APP_PORT=3000

# Koneksi OBS WebSocket (bisa juga diubah dari halaman Pengaturan)
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=
# Nama source capture card di OBS, contoh: HDMI Capture (kosong = otomatis)
OBS_SOURCE=

# ===== Gemini API (Tahap 3) =====
# Dapatkan di https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# ===== Claude CLI (Tahap 3) =====
# Perintah untuk menjalankan Claude Code. Biarkan "claude" jika bisa dijalankan dari PowerShell.
CLAUDE_COMMAND=claude
